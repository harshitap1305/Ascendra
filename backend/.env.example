# MongoDB Atlas — paste your SRV URI here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ascendra?retryWrites=true&w=majority
DATABASE_NAME=ascendra

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI — get free key at console.groq.com
GROQ_API_KEY=gsk_...

# App
DEBUG=true
CORS_ORIGINS=http://localhost:5173
